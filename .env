STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-maximized is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager fas-hue additional-editor-css banners-reloaded mk-readable-line mk-folder-lines mk-spaces-enabled mk-flow-replace mk-flow-minimal enable-heading-nowrap enable-edge-style default-outline-style fas-silver-light fas-silver-dark fas-bg-textures fas-h1-display fas-hr is-focused
